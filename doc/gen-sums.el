;;; gen-sums.el --- Write the released daemons' SHA-256 into the package  -*- lexical-binding: t; -*-

;;; Commentary:

;; emacs -Q --batch -l doc/gen-sums.el -f tandem-gen-sums VERSION SHA256SUMS FILE
;;
;; Writes FILE, lisp/tandem-daemon-sums.el, from the SHA256SUMS that
;; make dist wrote for VERSION.  `tandem-install-daemon' refuses a
;; download whose SHA-256 is not the one written here.

;;; Code:

(defun tandem-gen-sums ()
  "Write the sums file named on the command line."
  (pcase-let ((`(,version ,sums ,file) command-line-args-left)
              (entries nil))
    (with-temp-buffer
      (insert-file-contents sums)
      (dolist (line (split-string (buffer-string) "\n" t))
        (unless (string-match "\\`\\([0-9a-f]\\{64\\}\\) [ *]tandemd-\\([^-]+\\)-\\([a-z]+-[a-z0-9]+\\)\\(?:\\.exe\\)?\\'" line)
          (error "Not a line of SHA256SUMS: %s" line))
        (unless (equal (match-string 2 line) version)
          (error "%s is not version %s" line version))
        (push (cons (match-string 3 line) (match-string 1 line)) entries)))
    (setq entries (sort entries (lambda (a b) (string< (car a) (car b)))))
    (with-temp-file file
      (insert ";;; tandem-daemon-sums.el --- SHA-256 of the released daemons  -*- lexical-binding: t; -*-\n\n"
              ";; Generated by doc/gen-sums.el from make dist's SHA256SUMS; do not edit.\n\n"
              ";;; Commentary:\n\n"
              ";; `tandem-install-daemon' installs a downloaded daemon only if its\n"
              ";; SHA-256 is the one here, for this package's own version.\n\n"
              ";;; Code:\n\n"
              (format "(defconst tandem-daemon-sums-version %S\n  \"The version the sums below are for.\")\n\n" version)
              "(defconst tandem-daemon-sums\n  '(")
      (insert (mapconcat (lambda (e) (format "(%S . %S)" (car e) (cdr e))) entries "\n    "))
      (insert ")\n  \"The released daemons' SHA-256, by platform.\")\n\n"
              "(provide 'tandem-daemon-sums)\n;;; tandem-daemon-sums.el ends here\n"))
    (setq command-line-args-left nil)))

;;; gen-sums.el ends here
