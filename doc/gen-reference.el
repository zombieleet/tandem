;;; gen-reference.el --- Write the manual's command and option reference  -*- lexical-binding: t; -*-

;;; Commentary:

;; emacs -Q --batch -L lisp -l doc/gen-reference.el -f tandem-gen-reference FILE
;;
;; Loads tandem and writes FILE, a Texinfo node listing every command and
;; every user option with the first paragraph of its documentation, so the
;; manual can never leave one out.  `make check' fails when the reference
;; in the repository is out of date.

;;; Code:

(require 'tandem)
(require 'tandem-magit)
(require 'tandem-org)
(require 'tandem-notes)
(require 'tandem-install)
(require 'tandem-embark)
(require 'seq)
(require 'subr-x)

(defun tandem-gen--texi (text)
  "Return TEXT escaped for Texinfo."
  (replace-regexp-in-string "[@{}]" (lambda (c) (concat "@" c)) text t t))

(defun tandem-gen--doc (symbol kind)
  "Return the first paragraph of SYMBOL's documentation of KIND, for Texinfo.
KIND is `function' or `variable'."
  (let* ((doc (or (if (eq kind 'function)
                      (documentation symbol t)
                    (documentation-property symbol 'variable-documentation t))
                  ""))
         (doc (car (split-string doc "\n\n")))
         (doc (replace-regexp-in-string "\n" " " doc))
         ;; `symbol' quotes become code.
         (doc (tandem-gen--texi doc)))
    (replace-regexp-in-string "[`‘]\\([^'’]+\\)['’]" "@code{\\1}" doc)))

(defun tandem-gen--ours-p (symbol)
  "Return non-nil if SYMBOL is a public name of tandem's."
  (let ((name (symbol-name symbol)))
    (and (string-prefix-p "tandem" name)
         (not (string-match-p "--" name)))))

(defun tandem-gen--commands ()
  "Return tandem's commands, sorted."
  (let (found)
    (mapatoms (lambda (s)
                (when (and (tandem-gen--ours-p s) (commandp s) (not (get s 'byte-obsolete-info))
                           ;; Major and minor modes are described with their features,
                           ;; mouse handlers with the buttons they serve.
                           (not (string-suffix-p "-mode" (symbol-name s)))
                           (not (string-match-p "-click-" (symbol-name s))))
                  (push s found))))
    (sort found (lambda (a b) (string< a b)))))

(defun tandem-gen--options ()
  "Return tandem's user options, sorted."
  (let (found)
    (mapatoms (lambda (s)
                (when (and (tandem-gen--ours-p s) (custom-variable-p s))
                  (push s found))))
    (sort found (lambda (a b) (string< a b)))))

(defconst tandem-gen--lisp-directory
  (expand-file-name "../lisp/" (file-name-directory (or load-file-name buffer-file-name)))
  "The package's source, next to this file.")

(defvar tandem-gen--defaults nil
  "Each option's default as written in its defcustom: (SYMBOL . FORM).")

(defun tandem-gen--read-defaults ()
  "Read every defcustom's default form from lisp/tandem*.el."
  (dolist (file (directory-files tandem-gen--lisp-directory t "\\`tandem.*\\.el\\'"))
    (with-temp-buffer
      (insert-file-contents file)
      (condition-case nil
          (while t
            (let ((form (read (current-buffer))))
              (when (and (consp form) (eq (car form) 'defcustom))
                (push (cons (nth 1 form) (nth 2 form)) tandem-gen--defaults))))
        (end-of-file nil)))))

(defun tandem-gen--default (symbol)
  "Return SYMBOL's default, short, for Texinfo.
A constant shows as its value; a default computed when Emacs starts,
such as a path in the user's home, shows as the code that computes it,
so the manual is the same on every machine."
  (unless tandem-gen--defaults
    (tandem-gen--read-defaults))
  (let* ((cell (assq symbol tandem-gen--defaults))
         (form (cdr cell))
         (value (cond ((null cell)
                       ;; Not a defcustom, such as a global minor mode's
                       ;; variable: its value, which is a constant.
                       (let ((standard (car (get symbol 'standard-value))))
                         (condition-case nil (eval standard t) (error standard))))
                      ((and (consp form) (eq (car form) 'quote)) (cadr form))
                      (t form)))
         (text (prin1-to-string value)))
    (tandem-gen--texi (if (> (length text) 40) (concat (substring text 0 37) "...") text))))

(defun tandem-gen-reference ()
  "Write the reference node to the file named on the command line."
  (let ((file (car command-line-args-left)))
    (with-temp-file file
      (insert "@c Generated by doc/gen-reference.el; do not edit by hand.\n\n"
              "@node Reference\n@chapter Reference\n\n"
              "Every command and user option, with the first paragraph of its\n"
              "documentation.  @kbd{C-h f} and @kbd{C-h v} give the rest.\n\n"
              "@menu\n* Commands::\n* Options::\n@end menu\n\n"
              "@node Commands\n@section Commands\n\n@table @code\n")
      (dolist (command (tandem-gen--commands))
        (insert (format "@item M-x %s\n@findex %s\n%s\n\n" command command
                        (tandem-gen--doc command 'function))))
      (insert "@end table\n\n@node Options\n@section Options\n\n"
              "@kbd{M-x customize-group RET tandem RET} lists them too.\n\n@table @code\n")
      (dolist (option (tandem-gen--options))
        (insert (format "@item %s\n@vindex %s\nDefault: @code{%s}.  %s\n\n" option option
                        (tandem-gen--default option) (tandem-gen--doc option 'variable))))
      (insert "@end table\n"))
    (setq command-line-args-left (cdr command-line-args-left))))

;;; gen-reference.el ends here
